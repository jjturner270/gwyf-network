<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GWYFCommunityNetwork</AssemblyName>
    <RootNamespace>GwyfCommunity</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!--
    Game-bound code (BepInEx plugin, Harmony patches against the actual game
    types) compiles only when GWYF_REFS points at the game's interop references
    (BepInEx/interop on BepInEx 6 IL2CPP installs):
    - BepInEx.Core.dll, BepInEx.Unity.IL2CPP.dll, 0Harmony.dll  (BepInEx/core)
    - UnityEngine.dll, UnityEngine.CoreModule.dll, Assembly-CSharp.dll (interop)
    - Harmony (bundled with BepInEx 6)

    Everything else (identity, queue, network, observers, hooks) builds without
    the game so CI and unit tests can exercise the full pipeline.
  -->
  <PropertyGroup>
    <!-- BepInEx core loader DLLs live next to the interop folder (BepInEx/core). -->
    <GWYF_CORE_REFS Condition="'$(GWYF_CORE_REFS)' == ''">$(GWYF_REFS)/../core</GWYF_CORE_REFS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GameRuntime/**/*.cs" Condition="!Exists('$(GWYF_REFS)')" />
    <Compile Remove="test/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GWYF_REFS)')">
    <!-- IL2CPP builds name the interop game assembly Assembly-CSharp.dll (no prefix). -->
    <Reference Include="Assembly-CSharp"><HintPath>$(GWYF_REFS)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GWYF_REFS)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GWYF_REFS)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GWYF_REFS)/Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="Il2CppSystem.Core"><HintPath>$(GWYF_REFS)/Il2CppSystem.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(GWYF_CORE_REFS)/BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity"><HintPath>$(GWYF_CORE_REFS)/BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GWYF_CORE_REFS)/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GWYF_CORE_REFS)/0Harmony.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

</Project>